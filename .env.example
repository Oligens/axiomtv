# Browser-safe Vite configuration
VITE_API_URL=
VITE_ZAKAPRO_SDK_URL=https://cdn.zakapro.ht/sdk/v3/zaka.min.js
VITE_ZAKAPRO_APP_KEY=
VITE_ZAKAPRO_HUB_URL=
VITE_ZAKAPRO_WEBHOOK_URL=
VITE_AGWE_OCEAN_AUDIO_URL=/sounds/ocean-waves.mp3
VITE_AGWE_LOCALE=fr
VITE_AGWE_FPS=24
VITE_AGWE_RENDER_API_URL=

# Server-only variables — configure in the server/Vercel environment.
# NEVER expose these as VITE_ variables.
DATABASE_URL=
ZAKAPRO_APP_SECRET=
JWT_SECRET=
RESEND_API_KEY=

# Sci-Fi renderer — server only
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
OUTPUT_DIR=./output
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
FPS=24
VIDEO_FORMAT=mp4
RENDER_QUALITY=high
MUSIC_VOLUME=0.3
MAX_MEMORY_MB=3800
# Optional absolute/relative path to a music file
BACKGROUND_MUSIC_PATH=
